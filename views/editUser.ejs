<%- include('partials/header', { title: 'Edit User - Telangana Tourism' }) %>

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-lg border-0 rounded-lg overflow-hidden">
                <!-- Beautiful Header -->
                <div class="bg-primary text-white text-center py-4" style="background: linear-gradient(135deg, #0b5ed7 0%, #003399 100%);">
                    <h3 class="fw-bold mb-0"><i class="bi bi-pencil-square me-2"></i>Edit Registered User</h3>
                    <p class="mb-0 mt-2 text-light opacity-75">Update details for <%= user.name %></p>
                </div>
                
                <div class="card-body p-5 bg-white">
                    <% if (typeof error !== 'undefined' && error) { %>
                        <div class="alert alert-danger shadow-sm" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i> <%= error %>
                        </div>
                    <% } %>
                    <% if (typeof success !== 'undefined' && success) { %>
                        <div class="alert alert-success shadow-sm" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i> <%= success %>
                        </div>
                    <% } %>
                    
                    <form action="/admin/edit-user/<%= user.id %>" method="POST">
                        <div class="row">
                            <!-- Name Field (Floating Label) -->
                            <div class="col-md-6 mb-4">
                                <div class="form-floating">
                                    <input type="text" class="form-control bg-light" id="name" name="name" placeholder="User Name" value="<%= user.name %>" required>
                                    <label for="name">User Name <span class="text-danger">*</span></label>
                                </div>
                            </div>
                            
                            <!-- Email Field (Floating Label) -->
                            <div class="col-md-6 mb-4">
                                <div class="form-floating">
                                    <input type="email" class="form-control bg-light" id="email" name="email" placeholder="User Email" value="<%= user.email %>" required>
                                    <label for="email">User Email <span class="text-danger">*</span></label>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <!-- Password Field (Floating Label) -->
                            <div class="col-md-12 mb-4">
                                <div class="form-floating">
                                    <input type="password" class="form-control bg-light" id="password" name="password" placeholder="New Password (leave blank to keep current password)">
                                    <label for="password">New Password (leave blank to keep current)</label>
                                </div>
                                <small class="text-muted"><i class="bi bi-info-circle me-1"></i> Leave this field blank if you do not wish to change the user's password.</small>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-grid gap-3 d-md-flex justify-content-md-end mt-4">
                            <a href="/admin" class="btn btn-light btn-lg px-4 me-md-2 border shadow-sm">Cancel</a>
                            <button type="submit" class="btn btn-primary btn-lg px-5 shadow"><i class="bi bi-save-fill me-2"></i> Update User</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

<%- include('partials/footer') %>
