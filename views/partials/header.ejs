<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Telangana Tourism Blog' %></title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-light custom-navbar sticky-top">
  <div class="container">
    <a class="navbar-brand fw-bold text-primary" href="/">Telangana Tourism</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav ms-auto">
        <li class="nav-item">
          <a class="nav-link" href="/">Home</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/blogs">View Blogs</a>
        </li>
        <% if (locals.user) { %>
          <li class="nav-item">
            <a class="nav-link" href="/profile"><i class="bi bi-person-circle me-1"></i>My Profile</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/add-blog">Add Blog</a>
          </li>
          <% if (locals.user.isAdmin) { %>
          <li class="nav-item">
            <a class="nav-link fw-bold text-dark" href="/admin"><i class="bi bi-shield-lock me-1"></i>Admin</a>
          </li>
          <% } %>
          <li class="nav-item">
            <a class="nav-link text-danger fw-bold ms-lg-2" href="/logout"><i class="bi bi-box-arrow-left me-1"></i>Logout</a>
          </li>
        <% } else { %>
          <li class="nav-item">
            <a class="nav-link" href="/login">User Login</a>
          </li>
          <li class="nav-item">
            <a class="nav-link btn btn-primary text-white ms-lg-2 px-3" href="/register">Register</a>
          </li>
          <li class="nav-item">
            <a class="nav-link text-dark fw-bold ms-lg-2" href="/admin-login"><i class="bi bi-shield-lock me-1"></i>Admin Login</a>
          </li>
        <% } %>
      </ul>
    </div>
  </div>
</nav>

<main>
