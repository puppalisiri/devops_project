<%- include('partials/header', { title: 'Tourism Blogs - Telangana Tourism' }) %>

<!-- Blogs Hero Section -->
<section class="text-white py-5 mb-5 shadow-sm" style="background: linear-gradient(135deg, #0b5ed7 0%, #001f4d 100%);">
    <div class="container text-center py-4">
        <h1 class="display-4 fw-bold"><i class="bi bi-globe-central-south-asia me-2"></i>Discover Telangana</h1>
        <p class="lead mb-0 text-light opacity-75">Read amazing travel experiences shared by our community.</p>
    </div>
</section>

<div class="container my-5">
    
    <!-- Dynamic MySQL Search and Filter Panel -->
    <div class="row justify-content-center mb-5">
        <div class="col-lg-10">
            <form action="/blogs" method="GET" class="card shadow-sm border p-3 rounded-4 bg-white">
                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="input-group rounded-pill overflow-hidden border bg-light">
                            <span class="input-group-text bg-transparent border-0 ps-3"><i class="bi bi-search text-primary"></i></span>
                            <input type="text" name="search" class="form-control bg-transparent border-0 px-2" placeholder="Search title or text..." value="<%= filters.search || '' %>" style="box-shadow: none; height: 45px;">
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="rounded-pill overflow-hidden border bg-light">
                            <select name="district" class="form-select bg-transparent border-0 px-3" style="box-shadow: none; height: 45px;">
                                <option value="">All Districts</option>
                                <% const districts = ['Hyderabad', 'Warangal', 'Nizamabad', 'Karimnagar', 'Khammam', 'Mahabubnagar', 'Nalgonda', 'Adilabad', 'Medak', 'Rangareddy', 'Bhadrachalam', 'Mulugu', 'Other']; %>
                                <% districts.forEach(dist => { %>
                                    <option value="<%= dist %>" <%= filters.district === dist ? 'selected' : '' %>><%= dist %></option>
                                <% }) %>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="rounded-pill overflow-hidden border bg-light">
                            <select name="category" class="form-select bg-transparent border-0 px-3" style="box-shadow: none; height: 45px;">
                                <option value="">All Categories</option>
                                <% const categories = ['Historical Places', 'Temples', 'Waterfalls', 'Wildlife', 'Adventure', 'Cultural Heritage', 'Nature Tourism']; %>
                                <% categories.forEach(cat => { %>
                                    <option value="<%= cat %>" <%= filters.category === cat ? 'selected' : '' %>><%= cat %></option>
                                <% }) %>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-2 d-grid">
                        <button type="submit" class="btn btn-primary rounded-pill fw-bold shadow-sm" style="height: 45px;"><i class="bi bi-funnel-fill me-1"></i> Filter</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <% if (blogs && blogs.length > 0) { %>
        <div class="row g-4" id="blogsContainer">
            <% blogs.forEach(function(blog) { %>
                <div class="col-md-6 col-lg-4 blog-item">
                    <div class="card h-100 shadow-sm border-0 tourism-card overflow-hidden">
                        
                        <!-- Image Upload or Dynamic Fallback -->
                        <div class="position-relative">
                            <% if (blog.image_url) { %>
                                <img src="<%= blog.image_url %>" class="card-img-top" alt="<%= blog.title %>" style="height: 220px; object-fit: cover;">
                            <% } else { %>
                                <img src="/images/hero_bg.png" data-title="<%= blog.title %>" class="card-img-top wiki-img" alt="<%= blog.title %>" style="height: 220px; object-fit: cover;">
                            <% } %>
                            
                            <!-- District Badge floating on image -->
                            <span class="badge bg-warning text-dark position-absolute top-0 end-0 m-3 py-2 px-3 shadow">
                                <i class="bi bi-geo-alt-fill me-1"></i> <%= blog.district %>
                            </span>

                            <!-- Category Badge floating on image -->
                            <span class="badge <%= getCategoryColor(blog.category) %> position-absolute top-0 start-0 m-3 py-2 px-3 shadow">
                                <i class="bi bi-tag-fill me-1"></i> <%= blog.category %>
                            </span>
                        </div>

                        <div class="card-body d-flex flex-column p-4">
                            <h4 class="card-title fw-bold text-dark mb-1"><%= blog.title %></h4>
                            <p class="text-muted small mb-3"><i class="bi bi-person-circle me-1"></i> By <%= blog.author || 'Anonymous' %></p>
                            <!-- Truncated Description -->
                            <p class="card-text text-muted flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                                <%= blog.description %>
                            </p>
                            <div class="mt-4 border-top pt-3 d-flex justify-content-between align-items-center">
                                <span class="text-muted small"><i class="bi bi-heart-fill text-danger me-1"></i> <%= blog.likes_count || 0 %> likes</span>
                                <button class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-bold" data-bs-toggle="modal" data-bs-target="#blogModal<%= blog.id %>">
                                    Read Full <i class="bi bi-arrow-right ms-1"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Modal for Full Blog View (Pop-up) -->
                    <div class="modal fade" id="blogModal<%= blog.id %>" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
                            <div class="modal-content border-0 shadow-lg">
                                <div class="modal-header bg-light border-0 py-3 d-flex gap-2 align-items-center">
                                    <span class="badge bg-warning text-dark"><i class="bi bi-geo-alt-fill me-1"></i> <%= blog.district %></span>
                                    <span class="badge <%= getCategoryColor(blog.category) %>"><i class="bi bi-tag-fill me-1"></i> <%= blog.category %></span>
                                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body p-0">
                                    <% if (blog.image_url) { %>
                                        <img src="<%= blog.image_url %>" class="img-fluid w-100" style="max-height: 380px; object-fit: cover;">
                                    <% } else { %>
                                        <img src="/images/hero_bg.png" data-title="<%= blog.title %>" class="img-fluid w-100 wiki-img" style="max-height: 380px; object-fit: cover;">
                                    <% } %>
                                    <div class="p-4 p-md-5">
                                        <h2 class="fw-bold text-dark mb-2 display-6"><%= blog.title %></h2>
                                        <p class="text-muted mb-4 fs-5"><i class="bi bi-person-circle me-2"></i>Written by <span class="fw-bold text-dark"><%= blog.author || 'Anonymous' %></span></p>
                                        <p class="lead text-secondary mb-5" style="white-space: pre-line; line-height: 1.8;"><%= blog.description %></p>
                                        
                                        <!-- Likes System Section -->
                                        <div class="d-flex align-items-center gap-3 border-top border-bottom py-3 mb-4">
                                            <% if (locals.user) { %>
                                                <button class="btn <%= blog.user_liked ? 'btn-danger' : 'btn-outline-danger' %> rounded-pill px-4 py-2 fw-bold" id="likeBtn<%= blog.id %>" onclick="toggleLike(<%= blog.id %>)">
                                                    <i class="bi <%= blog.user_liked ? 'bi-heart-fill' : 'bi-heart' %> me-2"></i>
                                                    <span id="likeText<%= blog.id %>"><%= blog.user_liked ? 'Liked' : 'Like' %></span> 
                                                    (<span id="likeCount<%= blog.id %>"><%= blog.likes_count %></span>)
                                                </button>
                                            <% } else { %>
                                                <button class="btn btn-outline-secondary rounded-pill px-4 py-2 fw-bold" disabled>
                                                    <i class="bi bi-heart me-2"></i> Like (<%= blog.likes_count %>)
                                                </button>
                                                <a href="/login" class="text-muted text-decoration-none small"><i class="bi bi-info-circle me-1"></i> Log in to like</a>
                                            <% } %>
                                            <span class="text-muted ms-auto"><i class="bi bi-chat-left-text-fill text-primary me-2"></i><span id="commentsCountText<%= blog.id %>"><%= (commentsGrouped[blog.id] || []).length %></span> Comments</span>
                                        </div>

                                        <!-- Comments Section -->
                                        <div class="mb-4">
                                            <h5 class="fw-bold mb-3"><i class="bi bi-chat-dots-fill me-2 text-primary"></i>Comments</h5>
                                            <div class="comments-list border rounded-3 p-3 bg-light" id="commentsList<%= blog.id %>" style="max-height: 250px; overflow-y: auto;">
                                                <% const comments = commentsGrouped[blog.id] || []; %>
                                                <% if (comments.length > 0) { %>
                                                    <% comments.forEach(function(c) { %>
                                                        <div class="comment-item border-bottom pb-2 mb-2">
                                                            <div class="d-flex justify-content-between align-items-center">
                                                                <span class="fw-bold text-dark"><%= c.username %></span>
                                                                <span class="text-muted small"><%= new Date(c.created_at).toLocaleDateString('en-IN', { hour: '2-digit', minute: '2-digit' }) %></span>
                                                            </div>
                                                            <p class="text-secondary mb-0 small mt-1"><%= c.comment_text %></p>
                                                        </div>
                                                    <% }); %>
                                                <% } else { %>
                                                    <p class="text-muted text-center my-3 no-comments-placeholder">No comments yet. Share your thoughts!</p>
                                                <% } %>
                                            </div>
                                        </div>

                                        <!-- Comment Input -->
                                        <% if (locals.user) { %>
    <div class="comment-form mt-3">
        <div class="alert alert-danger d-none" id="commentAlert<%= blog.id %>"></div>
        <div class="input-group">
            <input type="text" id="commentInput<%= blog.id %>" class="form-control px-3" placeholder="Write a comment..." style="border-top-left-radius: 20px; border-bottom-left-radius: 20px; box-shadow: none;">
            <button class="btn btn-primary px-4" type="button" onclick="submitComment(<%= blog.id %>)" style="border-top-right-radius: 20px; border-bottom-right-radius: 20px;">
                <i class="bi bi-send-fill"></i>
            </button>
        </div>
    </div>
    <script>
        function validateComment(text) {
            const trimmed = text ? text.trim() : '';

            // 1. Empty Comment Restriction
            if (!trimmed) {
                return 'Comment cannot be empty';
            }

            // 2. Minimum and Maximum Comment Length Validation
            const MIN_LENGTH = 5;
            const MAX_LENGTH = 500;
            if (trimmed.length < MIN_LENGTH) {
                return 'Comment is too short';
            }
            if (trimmed.length > MAX_LENGTH) {
                return 'Comment exceeds maximum allowed length';
            }

            // 6. Link / URL Restriction
            if (/https?:\/\/|www\./i.test(trimmed)) {
                return 'Links are not allowed in comments';
            }

            // 7. Special Character Spam Restriction
            const specialChars = trimmed.replace(/[a-zA-Z0-9\s.,!?'"\(\)\-]/g, '');
            if (specialChars.length > 5 || (trimmed.length > 0 && (specialChars.length / trimmed.length) > 0.2)) {
                return 'Comment contains excessive unnecessary symbols or random characters';
            }

            // 5. Repeated Character Spam Prevention
            if (/(.)\1{4,}/.test(trimmed) || /(.{2,4})\1{3,}/i.test(trimmed)) {
                return 'Comment contains excessive repeated characters';
            }

            // 3. Bad Word / Profanity Filter
            const BAD_WORDS = [
                'badword', 'spamword', 'abuse', 'offensive',
                'idiot', 'stupid', 'crap', 'fudge', 'fool', 'jerk',
                'sh1t', 'asshole', 'bastard', 'bitch', 'dumbass', 'moron',
                'spam', 'scam', 'fake'
            ];
            const lower = trimmed.toLowerCase();
            for (const w of BAD_WORDS) {
                if (lower.includes(w)) {
                    return 'Inappropriate comment not allowed';
                }
            }

            return null;
        }
    </script>
<% } else { %>
    <div class="alert alert-secondary text-center rounded-3 p-3 small mb-0">
        <i class="bi bi-lock-fill me-1"></i> Please <a href="/login" class="fw-bold">Login</a> to write a comment.
    </div>
<% } %>

                                    </div>
                                </div>
                                <div class="modal-footer bg-light border-0">
                                    <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Close</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>
    <% } else { %>
        <!-- Empty state when Database is empty or search yields no results -->
        <div class="text-center my-5 py-5 bg-white rounded-4 shadow-sm border">
            <i class="bi bi-journal-x display-1 text-primary opacity-50 mb-3 d-block"></i>
            <h2 class="fw-bold mb-3">No blogs found</h2>
            <p class="text-muted mb-4 fs-5">Try search keywords or change the filter selectors.</p>
            <a href="/blogs" class="btn btn-outline-primary btn-lg px-4 me-2 rounded-pill"><i class="bi bi-arrow-clockwise me-1"></i> Reset Filters</a>
            <a href="/add-blog" class="btn btn-primary btn-lg px-4 rounded-pill"><i class="bi bi-pencil-square me-2"></i> Create Blog</a>
        </div>
    <% } %>
</div>

<script>
    // AJAX likes toggle
    function toggleLike(blogId) {
        fetch(`/blogs/${blogId}/like`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
        })
        .then(res => res.json())
        .then(data => {
            if (data.error) {
                alert(data.error);
                return;
            }
            
            const likeBtn = document.getElementById(`likeBtn${blogId}`);
            const likeText = document.getElementById(`likeText${blogId}`);
            const likeCount = document.getElementById(`likeCount${blogId}`);
            
            if (data.liked) {
                likeBtn.classList.remove('btn-outline-danger');
                likeBtn.classList.add('btn-danger');
                likeText.textContent = 'Liked';
                likeBtn.querySelector('i').classList.remove('bi-heart');
                likeBtn.querySelector('i').classList.add('bi-heart-fill');
            } else {
                likeBtn.classList.remove('btn-danger');
                likeBtn.classList.add('btn-outline-danger');
                likeText.textContent = 'Like';
                likeBtn.querySelector('i').classList.remove('bi-heart-fill');
                likeBtn.querySelector('i').classList.add('bi-heart');
            }
            likeCount.textContent = data.likesCount;
            
            // Sync count with card view
            const blogItem = likeBtn.closest('.blog-item');
            if (blogItem) {
                const cardLikes = blogItem.querySelector('.text-muted.small');
                if (cardLikes) {
                    cardLikes.innerHTML = `<i class="bi bi-heart-fill text-danger me-1"></i> ${data.likesCount} likes`;
                }
            }
        })
        .catch(err => console.error('Error toggling like:', err));
    }
    
    // AJAX comments submission
    function submitComment(blogId) {
        const input = document.getElementById(`commentInput${blogId}`);
        const text = input.value.trim();

        // Client-side validation
        const validationError = validateComment(text);
        const alertEl = document.getElementById(`commentAlert${blogId}`);
        if (validationError) {
            if (alertEl) {
                alertEl.textContent = validationError;
                alertEl.classList.remove('d-none');
            }
            return;
        } else {
            if (alertEl) {
                alertEl.classList.add('d-none');
                alertEl.textContent = '';
            }
        }

        fetch(`/blogs/${blogId}/comment`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ comment_text: text })
        })
        .then(res => {
            if (res.status === 401) {
                window.location.href = '/login';
                return null;
            }
            return res.json();
        })
        .then(data => {
            if (!data) return;
            if (data.error) {
                if (alertEl) {
                    alertEl.textContent = data.error;
                    alertEl.classList.remove('d-none');
                }
                return;
            }

            if (data.success) {
                if (alertEl) {
                    alertEl.classList.add('d-none');
                    alertEl.textContent = '';
                }
                const list = document.getElementById(`commentsList${blogId}`);
                const placeholder = list.querySelector('.no-comments-placeholder');
                if (placeholder) placeholder.remove();

                const commentDiv = document.createElement('div');
                commentDiv.className = 'comment-item border-bottom pb-2 mb-2';

                const now = new Date(data.comment.created_at);
                const timeStr = now.toLocaleDateString('en-IN', { hour: '2-digit', minute: '2-digit' });

                commentDiv.innerHTML = `
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-bold text-dark">${data.comment.username}</span>
                        <span class="text-muted small">${timeStr}</span>
                    </div>
                    <p class="text-secondary mb-0 small mt-1">${data.comment.comment_text}</p>
                `;

                list.appendChild(commentDiv);
                list.scrollTop = list.scrollHeight;
                input.value = '';

                // Increment comments badge count
                const countBadge = document.getElementById(`commentsCountText${blogId}`);
                if (countBadge) {
                    countBadge.textContent = parseInt(countBadge.textContent) + 1;
                }
            }
        })
        .catch(err => console.error('Error posting comment:', err));
    }

    // Dynamic Image Fetching from Wikipedia for fallbacks
    document.addEventListener('DOMContentLoaded', function() {
        const wikiImages = document.querySelectorAll('.wiki-img');
        wikiImages.forEach(img => {
            const title = img.getAttribute('data-title');
            const url = `https://en.wikipedia.org/w/api.php?action=query&titles=${encodeURIComponent(title)}&prop=pageimages&format=json&pithumbsize=800&origin=*`;
            
            fetch(url)
                .then(response => response.json())
                .then(data => {
                    const pages = data.query.pages;
                    const pageId = Object.keys(pages)[0];
                    if (pageId !== '-1' && pages[pageId].thumbnail) {
                        img.src = pages[pageId].thumbnail.source;
                    }
                })
                .catch(err => console.error('Error fetching Wikipedia image for', title, err));
        });
    });
</script>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

<%- include('partials/footer') %>