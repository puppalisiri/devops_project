<%- include('partials/header', { title: 'Login - Telangana Tourism' }) %>

<div class="container">
    <div class="form-card">
        <h2 class="text-center mb-4 fw-bold">Login</h2>
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger" role="alert">
                <% if (error === 'User not registered. Please register first.') { %>
                    <i class="bi bi-x-circle-fill"></i> User not registered. <br>
                    <a href="/register" class="alert-link">Click here to register first.</a>
                <% } else { %>
                    <i class="bi bi-exclamation-circle-fill"></i> <%= error %>
                <% } %>
            </div>
        <% } %>
        <% if (typeof success !== 'undefined' && success) { %>
            <div class="alert alert-success" role="alert">
                <i class="bi bi-check-circle-fill"></i> <%= success %>
            </div>
        <% } %>
        <form action="/login" method="POST">
            <div class="mb-3">
                <label for="email" class="form-label">Email Address</label>
                <input type="email" class="form-control" id="email" name="email" placeholder="Enter Email" required>
            </div>
            <div class="mb-3">
                <label for="password" class="form-label">Password</label>
                <input type="password" class="form-control" id="password" name="password" placeholder="Enter Password" required>
            </div>
            <div class="form-check mb-4">
                <input class="form-check-input" type="checkbox" id="showPassword">
                <label class="form-check-label" for="showPassword">
                    Show Password
                </label>
            </div>
            <div class="d-grid">
                <button type="submit" class="btn btn-primary btn-lg">Login</button>
            </div>
        </form>
        <p class="text-center mt-3 mb-0">Don't have an account? <a href="/register" class="text-decoration-none">Register here</a></p>
    </div>
</div>

<script>
    const passwordInput = document.getElementById('password');
    const showPasswordCheck = document.getElementById('showPassword');

    // Show/Hide password toggle
    showPasswordCheck.addEventListener('change', function() {
        if (this.checked) {
            passwordInput.type = 'text';
        } else {
            passwordInput.type = 'password';
        }
    });
</script>

<!-- Add Bootstrap Icons for the alert icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

<%- include('partials/footer') %>