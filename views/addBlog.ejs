<%- include('partials/header', { title: 'Add Blog - Telangana Tourism' }) %>

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-lg border-0 rounded-lg overflow-hidden">
                <!-- Beautiful Header -->
                <div class="bg-primary text-white text-center py-4" style="background: linear-gradient(135deg, #0b5ed7 0%, #003399 100%);">
                    <h3 class="fw-bold mb-0"><i class="bi bi-pencil-square me-2"></i>Share Your Tourism Experience</h3>
                    <p class="mb-0 mt-2 text-light opacity-75">Tell the world about your amazing trip in Telangana</p>
                </div>
                
                <div class="card-body p-5 bg-white">
                    <% if (typeof error !== 'undefined' && error) { %>
                        <div class="alert alert-danger shadow-sm" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i> <%= error %>
                        </div>
                    <% } %>
                    <% if (typeof success !== 'undefined' && success) { %>
                        <div class="alert alert-success shadow-sm" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i> <%= success %>
                        </div>
                    <% } %>
                    
                    <form action="/add-blog" method="POST" enctype="multipart/form-data">
                        <div class="row">
                            <!-- Title Field (Floating Label) -->
                            <div class="col-md-6 mb-4">
                                <div class="form-floating">
                                    <input type="text" class="form-control bg-light" id="title" name="title" placeholder="Blog Title" required>
                                    <label for="title">Blog Title <span class="text-danger">*</span></label>
                                </div>
                            </div>
                            
                            <!-- Author Field (Floating Label) -->
                            <div class="col-md-6 mb-4">
                                <div class="form-floating">
                                    <input type="text" class="form-control bg-light" id="author" name="author" placeholder="Author Name" value="<%= locals.user ? locals.user.name : '' %>" required>
                                    <label for="author">Author Name <span class="text-danger">*</span></label>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <!-- District Field (Dropdown) -->
                            <div class="col-md-6 mb-4">
                                <div class="form-floating">
                                    <select class="form-select bg-light" id="district" name="district" required>
                                        <option value="" selected disabled>Select District</option>
                                        <option value="Hyderabad">Hyderabad</option>
                                        <option value="Warangal">Warangal</option>
                                        <option value="Nizamabad">Nizamabad</option>
                                        <option value="Karimnagar">Karimnagar</option>
                                        <option value="Khammam">Khammam</option>
                                        <option value="Mahabubnagar">Mahabubnagar</option>
                                        <option value="Nalgonda">Nalgonda</option>
                                        <option value="Adilabad">Adilabad</option>
                                        <option value="Medak">Medak</option>
                                        <option value="Rangareddy">Rangareddy</option>
                                        <option value="Bhadrachalam">Bhadrachalam</option>
                                        <option value="Mulugu">Mulugu</option>
                                        <option value="Other">Other</option>
                                    </select>
                                    <label for="district">District <span class="text-danger">*</span></label>
                                </div>
                            </div>

                            <!-- Category Field (Dropdown) -->
                            <div class="col-md-6 mb-4">
                                <div class="form-floating">
                                    <select class="form-select bg-light" id="category" name="category" required>
                                        <option value="" selected disabled>Select Category</option>
                                        <option value="Historical Places">Historical Places</option>
                                        <option value="Temples">Temples</option>
                                        <option value="Waterfalls">Waterfalls</option>
                                        <option value="Wildlife">Wildlife</option>
                                        <option value="Adventure">Adventure</option>
                                        <option value="Cultural Heritage">Cultural Heritage</option>
                                        <option value="Nature Tourism">Nature Tourism</option>
                                    </select>
                                    <label for="category">Category <span class="text-danger">*</span></label>
                                </div>
                            </div>
                        </div>

                        <!-- Image Upload Field -->
                        <div class="mb-4">
                            <label for="image" class="form-label fw-bold text-secondary">Upload Tourist Place Image <span class="text-danger">*</span></label>
                            <input class="form-control bg-light py-2" type="file" id="image" name="image" accept="image/*" required>
                            <div class="form-text">Supported formats: JPG, JPEG, PNG, WEBP, GIF. Max size: 5MB.</div>
                        </div>

                        <!-- Description Field -->
                        <div class="form-floating mb-2">
                            <textarea class="form-control bg-light" id="description" name="description" placeholder="Share your experience..." style="height: 220px; resize: none;" required></textarea>
                            <label for="description">Blog Description <span class="text-danger">*</span></label>
                        </div>
                        
                        <!-- Character Counter -->
                        <div class="d-flex justify-content-between mb-5">
                            <small class="text-muted"><i class="bi bi-info-circle me-1"></i> Make it descriptive and engaging.</small>
                            <small class="fw-bold text-primary" id="charCount">0 characters</small>
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-grid gap-3 d-md-flex justify-content-md-end">
                            <a href="/blogs" class="btn btn-light btn-lg px-4 me-md-2 border shadow-sm">Cancel</a>
                            <button type="submit" class="btn btn-primary btn-lg px-5 shadow"><i class="bi bi-send-fill me-2"></i> Publish Blog</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    const descInput = document.getElementById('description');
    const charCount = document.getElementById('charCount');

    // Live character counter for description
    descInput.addEventListener('input', function() {
        const len = this.value.length;
        charCount.textContent = len + ' characters';
        
        if (len > 1000) {
            charCount.classList.remove('text-primary');
            charCount.classList.add('text-danger');
        } else {
            charCount.classList.add('text-primary');
            charCount.classList.remove('text-danger');
        }
    });
</script>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

<%- include('partials/footer') %>